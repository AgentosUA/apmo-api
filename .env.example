DB_URL=
JWT_SECRET=
MAPS_URL=

# Public URLs. API_PUBLIC_URL is the API origin without /api (OAuth callbacks are
# <API_PUBLIC_URL>/api/auth/oauth/<provider>/callback). FRONTEND_URL is where
# users return after signing in and where links in emails point.
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Email (Resend, https://resend.com). Without RESEND_API_KEY emails are skipped.
# MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Arma Plan Maker <no-reply@arma-plan-maker.com>
MAIL_REPLY_TO=

# Sign in with Google (https://console.cloud.google.com/apis/credentials).
# OAuth client "Web application", redirect URI:
# <API_PUBLIC_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in through Steam (OpenID 2.0, no keys needed). STEAM_API_KEY is optional
# (https://steamcommunity.com/dev/apikey): adds the Steam nickname and avatar.
STEAM_AUTH_ENABLED=false
STEAM_API_KEY=

# Sign in with VTG (asp-api OpenID Connect provider, see asp-api/docs/sso.md).
# Register the client in the VTG admin ("Apps") with the redirect URI
# <API_PUBLIC_URL>/api/auth/oauth/vtg/callback and scopes profile, email.
# VTG_ISSUER is the OIDC_ISSUER of asp-api, e.g. https://<asp-api host>/api/oidc
VTG_ISSUER=
VTG_CLIENT_ID=
VTG_CLIENT_SECRET=
# Optional, default: openid profile email
VTG_SCOPE=

# MinIO (avatars). Inside docker compose the API talks to http://minio:9000,
# these values are used to build public file URLs and for local `pnpm dev`.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=apmo
MINIO_ROOT_PASSWORD=change-me-please
# Optional: public URL of MinIO when it is behind a proxy / another domain,
# e.g. https://files.arma-plan-maker.com. Avatar URL: <MINIO_PUBLIC_URL>/user-avatars/...
MINIO_PUBLIC_URL=

# Infra (docker-compose.yml)
COMPOSE_PROJECT_NAME=apmo
API_PORT=3000
MINIO_UI_PORT=9001
# minio/minio is no longer published on Docker Hub, override if needed.
MINIO_IMAGE=
