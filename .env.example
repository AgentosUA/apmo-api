DB_URL=
JWT_SECRET=
GMAIL_APP_SECRET=
MAPS_URL=

# MinIO (avatars). Inside docker compose the API talks to http://minio:9000,
# these values are used to build public file URLs and for local `pnpm dev`.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=apmo
MINIO_ROOT_PASSWORD=change-me-please
# Optional: public URL of MinIO when it is behind a proxy / another domain,
# e.g. https://files.arma-plan-maker.com. Avatar URL: <MINIO_PUBLIC_URL>/user-avatars/...
MINIO_PUBLIC_URL=

# Infra (docker-compose.yml)
COMPOSE_PROJECT_NAME=apmo
API_PORT=3000
MINIO_UI_PORT=9001
# minio/minio is no longer published on Docker Hub, override if needed.
MINIO_IMAGE=
